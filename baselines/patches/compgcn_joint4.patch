+from collections import defaultdict
+import math
+
@@ -2 +5,34 @@ from helper import *
-from torch.utils.data import Dataset
+from torch.utils.data import Dataset, Sampler
+
+
+class RelationBalancedBatchSampler(Sampler):
+	"""Relation-homogeneous batches with BioGT-equivalent fixed epoch length."""
+	def __init__(self, triples, batch_size, seed=42):
+		self.batch_size = int(batch_size)
+		self.seed = int(seed)
+		self.epoch = 0
+		self.indices_by_relation = defaultdict(list)
+		for index, item in enumerate(triples):
+			self.indices_by_relation[int(item['triple'][1])].append(index)
+		self.relations = sorted(self.indices_by_relation)
+		self.num_batches = max(
+			len(self.relations),
+			math.ceil(len(triples) / self.batch_size),
+		)
+
+	def __iter__(self):
+		generator = torch.Generator().manual_seed(self.seed + self.epoch * 100003)
+		offset = self.epoch % len(self.relations)
+		self.epoch += 1
+		for step in range(self.num_batches):
+			relation = self.relations[(step + offset) % len(self.relations)]
+			indices = self.indices_by_relation[relation]
+			sampled = torch.randint(
+				len(indices),
+				(self.batch_size,),
+				generator=generator,
+			).tolist()
+			yield [indices[index] for index in sampled]
+
+	def __len__(self):
+		return self.num_batches
