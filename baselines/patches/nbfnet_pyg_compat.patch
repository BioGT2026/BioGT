@@ -0,0 +1,59 @@
+"""Small torch-scatter compatibility layer implemented with native PyTorch."""
+
+from __future__ import annotations
+
+import torch
+
+
+def _expanded_index(index, src, dim):
+    shape = [1] * src.ndim
+    shape[dim] = index.numel()
+    return index.reshape(shape).expand_as(src)
+
+
+def scatter(src, index, dim=0, out=None, dim_size=None, reduce="sum"):
+    if dim < 0:
+        dim += src.ndim
+    if dim_size is None:
+        dim_size = int(index.max().item()) + 1 if index.numel() else 0
+    if out is None:
+        shape = list(src.shape)
+        shape[dim] = dim_size
+        out = src.new_zeros(shape)
+    expanded_index = _expanded_index(index, src, dim)
+
+    if reduce in {"sum", "add"}:
+        return out.scatter_add_(dim, expanded_index, src)
+    if reduce == "mean":
+        out.scatter_add_(dim, expanded_index, src)
+        count_shape = [1] * src.ndim
+        count_shape[dim] = dim_size
+        counts = src.new_zeros(count_shape)
+        count_values = src.new_ones([1] * (src.ndim - 1) + [index.numel()])
+        count_values = count_values.movedim(-1, dim)
+        count_index = index.reshape(
+            [index.numel() if axis == dim else 1 for axis in range(src.ndim)]
+        )
+        counts.scatter_add_(dim, count_index, count_values)
+        return out / counts.clamp_min(1)
+    if reduce in {"max", "min"}:
+        reduce_name = "amax" if reduce == "max" else "amin"
+        return out.scatter_reduce_(
+            dim,
+            expanded_index,
+            src,
+            reduce=reduce_name,
+            include_self=False,
+        )
+    raise ValueError(f"Unsupported scatter reduction: {reduce}")
+
+
+def scatter_add(src, index, dim=0, out=None, dim_size=None):
+    return scatter(
+        src,
+        index,
+        dim=dim,
+        out=out,
+        dim_size=dim_size,
+        reduce="sum",
+    )
